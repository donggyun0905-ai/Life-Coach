app/
├─ main.py                    # FastAPI 엔트리포인트, 라우터 포함
├─ config.py                  # 환경변수/키 관리(.env 읽기)
├─ db/
│  ├─ dao.py                  # DB I/O 레이어 (SQLAlchemy/psycopg)
│  ├─ models.py               # ORM 모델(Users, DailyActivity, Sleep, …)
│  └─ schema.sql              # (선택) 초기 스키마
├─ routers/
│  ├─ summary.py              # /summary 일/주간 요약 API
│  ├─ predict.py              # /predict/week 예측 API
│  ├─ anomaly.py              # /anomaly/today 이상탐지 API
│  ├─ coach.py                # /coach/daily 코칭 문장 생성(LLM)
│  ├─ meds.py                 # /meds/info 복약 정보 요약
│  ├─ share.py                # /share/caregiver 보호자 리포트
│  └─ healthcheck.py          # /health 시스템 상태
├─ services/
│  ├─ feature_engine.py       # 피처/점수 계산(EMA, 수면 점수 분해 등)
│  ├─ goal_adaptive.py        # 개인 적응형 목표 보정 로직
│  ├─ ml_predict.py           # Prophet/ETS 예측 래퍼
│  ├─ anomaly.py              # IsolationForest/z-score 이상탐지
│  ├─ adherence.py            # 권고 이행 확률(Logistic) 추정
│  ├─ xai.py                  # SHAP/특성중요도 + 설명 텍스트 생성
│  ├─ orchestrator.py         # 결과 취합 → 코칭 입력 payload 생성
│  ├─ meds_service.py         # 식약처 API 래퍼/캐시 + 복약 요약 데이터
│  ├─ weather_service.py      # 기상청/에어코리아 수집/캐시
│  ├─ transit_service.py      # 버스 도착/정거장 수(선택) + 대기시간 로직
│  ├─ embedding_service.py    # OpenAI Embeddings 인덱싱/검색
│  ├─ llm_service.py          # OpenAI Chat 호출 래퍼(프롬프트 빌드)
│  └─ auth.py                 # 토큰 검증(간단), rate-limit 훅
|  |-  mi_band_service.py #웨어러블 api
├─ jobs/
│  ├─ batch.py                # 03:00 배치(피처 업데이트/예측/인덱스 재생성)
│  └─ workers.py              # RQ/Celery 큐 작업자(선택)
├─ utils/
│  ├─ timeutil.py             # TZ/UTC 변환
│  ├─ cache.py                # Redis/로컬 캐시
│  └─ logging.py              # 구조화 로깅
├─ schemas/
│  ├─ dto.py                  # Pydantic 응답/요청 스키마
│  └─ enums.py                # 연령대/권고 타입 등 열거형
└─ tests/
   ├─ test_features.py        # 피처/점수 단위테스트
   ├─ test_ml.py              # 예측/이상탐지 테스트
   └─ test_api.py             # 라우터 통합 테스트
